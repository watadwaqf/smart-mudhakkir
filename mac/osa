#!/bin/zsh
# قفلٌ واحد لكلّ أوامر «التذكيرات» و«التقويم»: الجولة تفتحها مرّاتٍ متداخلة (الصفحات، والآفاق، والمرآة)،
# و«التذكيرات» لا تنفّذ إلّا أمرًا واحدًا في كلّ مرّة، فكانت تصطفّ حتّى بلغت المزامنة نصف ساعة وعلقت أخرى ساعة.
# فتتوالى هنا واحدًا بعد واحد. والانتظار ١٥ دقيقة على الأكثر، ثمّ يخرج بخطأ ولا يعلق.
# config.py ← osa يمرّر مسار القفل في MUD_OSA_LOCK.
exec /usr/bin/lockf -k -t 900 "${MUD_OSA_LOCK:-${TMPDIR:-/tmp}/smart-mudhakkir-osa.lock}" /usr/bin/osascript "$@"
